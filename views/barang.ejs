<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Manajemen barang</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="container mt-5">
  <h2>Manajemen barang</h2>
  <a href="/barang/tambah" class="btn btn-primary mb-3">Tambah barang</a>
  <div class="table-responsive">
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nama</th>
          <th>Harga</th>
          <th>Stok</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (listBarang.length === 0) { %>
        <tr>
          <td colspan="5">Belum ada barang.</td>
        </tr>
        <% } %>
        <% listBarang.forEach(b => { %>
        <tr>
          <td><%= b.id %></td>
          <td><%= b.nama %></td>
          <td><%= b.harga %></td>
          <td><%= b.stok %></td>
          <td>
            <a href="/barang/edit/<%= b.id %>" class="btn btn-warning btn-sm">Edit</a>
            <form action="/barang/hapus/<%= b.id %>" method="POST" class="d-inline" onsubmit="return confirm('Yakin hapus barang ini?')">
              <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</body>

</html>